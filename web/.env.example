# PostgreSQL connection string
# For Docker Compose: postgresql://collectr:collectr_dev@localhost:5432/collectr
# For Coolify: set in the Coolify dashboard (points to the db service)
DATABASE_URL=

# PokéWallet API key (free) — needed for Pokemon card images and CardMarket EUR prices
# Sign up at https://pokewallet.io to get your key
POKEWALLET_API_KEY=

# Google OAuth (free) — needed for multi-user authentication
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Auth.js URL — set to your app's public URL
AUTH_URL=http://localhost:3000

# Postgres password (used by docker-compose)
POSTGRES_PASSWORD=collectr_dev

# Cron schedule for price refresh (default: 3:30 AM daily)
# PRICE_REFRESH_CRON=30 3 * * *
