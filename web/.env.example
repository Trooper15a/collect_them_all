# PostgreSQL connection string
# For Docker Compose: postgresql://collectr:collectr_dev@localhost:5432/collectr
# For Coolify: set in the Coolify dashboard (points to the db service)
DATABASE_URL=

# PokéWallet API key (free) — needed for Pokemon card images and CardMarket EUR prices
# Sign up at https://pokewallet.io to get your key
POKEWALLET_API_KEY=

# Google OAuth (free) — needed for multi-user authentication
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=

# Auth.js URL — set to your app's public URL
AUTH_URL=http://localhost:3000

# Postgres password (used by docker-compose)
POSTGRES_PASSWORD=collectr_dev

# Cron schedule for price refresh (default: 3:30 AM daily)
# PRICE_REFRESH_CRON=30 3 * * *

# TCGCSV price import categories — comma-separated category IDs to import
# (e.g. TCGCSV_CATEGORIES=3,1,2). Leave unset to import Pokémon ENG+JAP only (3,85).
# Full ID list: see TCGCSV_CATEGORIES in src/lib/tcgcsv.ts
# (3=Pokémon, 85=Pokémon Japan, 1=Magic, 2=Yu-Gi-Oh!, 68=One Piece, 71=Lorcana,
#  63=Digimon, 27=Dragon Ball Super, 80=DB Fusion World, 62=Flesh and Blood,
#  79=Star Wars Unlimited, 16=Vanguard, 20=Weiss Schwarz, 24=Final Fantasy,
#  81=Union Arena)
# Note: TCGCSV asks clients to stay under ~10,000 requests per 24h (see src/lib/tcgcsv.ts).
# TCGCSV_CATEGORIES=3,85
